# Copie para .env e preencha com os dados do SEU projeto Supabase
# (Painel > Project Settings > API). Sem estas variáveis, o app funciona só no aparelho.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
# NUNCA coloque a service_role key aqui: ela dá acesso total ao banco.
